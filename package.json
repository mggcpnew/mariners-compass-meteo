{
  "name": "mariners-compass-meteo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "ingest",
    "packages/core",
    "packages/api"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p packages/core && tsc -p packages/api && tsc -p ingest && tsc -p scripts",
    "ingest": "npm run ingest -w ingest",
    "notice:add": "node --env-file-if-exists=.env.local scripts/notices.ts add",
    "notice:checked": "node --env-file-if-exists=.env.local scripts/notices.ts checked"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.13.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
