{
  "name": "mariners-compass-meteo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "ingest",
    "packages/core",
    "packages/api"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "postinstall": "npm run build:packages",
    "build:packages": "tsc -p packages/core/tsconfig.build.json && tsc -p packages/api/tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p packages/core && tsc -p packages/api && tsc -p ingest && tsc -p scripts && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json && tsc -p e2e",
    "ingest": "npm run ingest -w ingest",
    "notice:add": "node --env-file-if-exists=.env.local scripts/notices.ts add",
    "notice:checked": "node --env-file-if-exists=.env.local scripts/notices.ts checked",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:lighthouse": "node e2e/lighthouse.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.13.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "playwright-core": "1.64.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
