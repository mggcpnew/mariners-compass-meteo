# Modelo de variáveis de ambiente (B9). Copie para .env.local e preencha.
# NUNCA coloque valores secretos neste arquivo: ele é versionado.

# Supabase
SUPABASE_URL=
# Secret: só em .env.local, nos secrets do GitHub Actions e no Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Secret (Vercel): segredo do HMAC do IP no limite por cliente do /point.
# O IP bruto nunca é gravado. Gere um valor aleatório longo.
CLIENT_HASH_SECRET=
# Bucket privado dos arquivos de grade (criado por migração) [PROPOSTA]
GRID_BUCKET=grids

# Fontes
GRID_SOURCE=openmeteo
# Obrigatório: live em produção; simulated em dev e testes. Sem valor, o app não sobe.
SOURCE_MODE=simulated
# Endpoints lidos na documentação em 17/11/2026 (T-07). Sem valor, o job e o
# /point falham sem chamar a fonte.
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# Vazio = a fonte escolhe o modelo (model_runs.model = auto) [PROPOSTA].
# Exemplo documentado: ecmwf_ifs. A resposta não informa o modelo usado.
OPENMETEO_MODEL_FORECAST=
OPENMETEO_MODEL_MARINE=
FORECAST_DAYS=9

# Orçamento e cache do /point
POINT_DAILY_BUDGET=4000
POINT_OPERATING_PCT=80
POINT_CACHE_TTL_S=10800
POINT_STALE_MAX_S=21600
POINT_PARTIAL_TTL_S=900
POINT_MAX_PER_MIN=100
POINT_MAX_PER_HOUR=1000
POINT_ROUND_DEG=0.25
# Limite por cliente do /point (T-02) [PROPOSTA]: on|off; chamadas por hora e por dia (2 por miss)
POINT_CLIENT_LIMIT=on
POINT_CLIENT_MAX_PER_HOUR=40
POINT_CLIENT_MAX_PER_DAY=200
# max-age das respostas de sucesso do /point e do /notices [PROPOSTA]
POINT_CACHE_CONTROL_S=60
NOTICES_CACHE_S=60

# Orçamento do job de ingestão
INGEST_ROUND_BUDGET=885
INGEST_DAILY_BUDGET=3540
INGEST_RETRY_MAX=2
INGEST_MAX_PER_MIN=300

# Grades e vencimento
FRAMES_CACHE_S=60
GRID_STALE_HOURS=18
GRID_EXPIRED_HOURS=48
GRID_BBOX=-54,-35,-30,5
GRID_RES_DEG=2
GRID_BAY_BBOX=-44,-24,-42,-22
GRID_BAY_RES_DEG=0.25
BAY_GRID_MIN_ZOOM=9

# Avisos oficiais
NOTICE_CHECK_MAX_AGE_H=24

# Fase 2 (Web Push). A chave privada é secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
