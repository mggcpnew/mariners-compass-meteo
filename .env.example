# Modelo de variáveis de ambiente (B9). Copie para .env.local e preencha.
# NUNCA coloque valores secretos neste arquivo: ele é versionado.

# Supabase
SUPABASE_URL=
# Secret: só em .env.local, nos secrets do GitHub Actions e no Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado dos arquivos de grade (criado por migração) [PROPOSTA]
GRID_BUCKET=grids

# Fontes
GRID_SOURCE=openmeteo
# live em produção; simulated em dev e testes
SOURCE_MODE=simulated
# Sem padrão (T-07). Sem valor, o job e o /point falham sem chamar a fonte.
OPENMETEO_FORECAST_URL=
OPENMETEO_MARINE_URL=
# Vazio = a fonte escolhe o modelo [PROPOSTA]
OPENMETEO_MODEL_FORECAST=
OPENMETEO_MODEL_MARINE=
FORECAST_DAYS=9

# Orçamento e cache do /point
POINT_DAILY_BUDGET=4000
POINT_OPERATING_PCT=80
POINT_CACHE_TTL_S=10800
POINT_STALE_MAX_S=21600
POINT_PARTIAL_TTL_S=900
POINT_MAX_PER_MIN=100
POINT_MAX_PER_HOUR=1000
POINT_ROUND_DEG=0.25

# Orçamento do job de ingestão
INGEST_ROUND_BUDGET=885
INGEST_DAILY_BUDGET=3540
INGEST_RETRY_MAX=2
INGEST_MAX_PER_MIN=300

# Grades e vencimento
FRAMES_CACHE_S=60
GRID_STALE_HOURS=18
GRID_EXPIRED_HOURS=48
GRID_BBOX=-54,-35,-30,5
GRID_RES_DEG=2
GRID_BAY_BBOX=-44,-24,-42,-22
GRID_BAY_RES_DEG=0.25
BAY_GRID_MIN_ZOOM=9

# Avisos oficiais
NOTICE_CHECK_MAX_AGE_H=24

# Fase 2 (Web Push). A chave privada é secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
